# Copy to .env for local development:  cp .env.example .env
# In CI these are provided by the deploy workflow / repo variables instead.

# Base path the app is served from.
#   "/"            local dev, a user/org GitHub Pages site, or a custom domain
#   "/<repo>/"     a GitHub Pages *project* site (the deploy workflow sets this)
VITE_BASE=/

# HTTPS endpoint that ingests tracked events (the AWS Lambda Function URL),
# no trailing slash. The service worker PUTs batches to `${VITE_LAMBDA_URL}/add-events`
# and sendEventNow() posts there directly. Leave blank until the Lambda exists —
# events then just accumulate in IndexedDB and flush once it is set.
VITE_LAMBDA_URL=

# Sent as the `tenant_name` header so the backend can attribute events to this site.
VITE_TENANT_NAME=storefront.local

# Base URL for catalog/product JSON and product media. Defaults to
# `${BASE_URL}storage` (the files under public/storage/). Point it at a media
# CDN later without touching any component.
VITE_STORAGE_BASE=

# Cache-bust / build id baked into the service worker. CI sets this to the
# GitHub run number; when unset locally it falls back to a timestamp.
SW_VERSION=
