# ---- Node / Vite (storefront) ----
node_modules/
storefront/dist/
storefront/.env
storefront/.env.local
# yarn is the package manager here; don't commit a competing npm lockfile
package-lock.json
# yarn berry local state (if anyone opts in)
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*
# generated per build by scripts/gen-build-config.mjs
storefront/src/generated/
storefront/public/service-worker.js

# ---- Docker ----
/.env
/.env.local

# ---- Django (dashboard) ----
dashboard/.venv/
dashboard/media/
dashboard/staticfiles/
dashboard/scratch_storage/
dashboard/.env
__pycache__/
*.py[cod]

# ---- OS / editor ----
.DS_Store
*.log
!raw_plans/*.log

# root-level scratch storage working copy (NOT storefront/public/storage/, which
# is committed sample content, nor dashboard exports)
/storage/