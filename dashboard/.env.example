# Inventory dashboard config — `cp .env.example .env` and edit.
# All values are optional; the defaults target local disk + the storefront's
# bundled storage tree.

# --- core ---
# DEBUG=True also enables the no-login auto-staff middleware. Set False for a
# real deployment (then create a user with `manage.py createsuperuser`).
DEBUG=True
# SECRET_KEY=change-me-in-production
# TIME_ZONE=Asia/Kolkata
# CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# --- where "Refresh / Publish" write ---
# local (default) -> a directory on disk;  s3 -> an S3 bucket via django-storages
EXPORT_BACKEND=local
# EXPORT_LOCAL_ROOT defaults to MEDIA_ROOT (dashboard/media/), so the generated
# catalog/product JSON + rendered media land in the same storage-shaped mirror as
# the uploaded originals. Point it straight at the storefront to skip a sync step:
# EXPORT_LOCAL_ROOT=../storefront/public/storage
# MEDIA_ROOT=./media

# --- S3 (only read when EXPORT_BACKEND=s3) ---
# AWS_STORAGE_BUCKET_NAME=barebrilliant-storage
# AWS_S3_REGION_NAME=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_LOCATION=                       # key prefix inside the bucket, e.g. "storage"
# AWS_S3_CUSTOM_DOMAIN=cdn.barebrilliant.com   # CDN host for generated URLs
# AWS_S3_ENDPOINT_URL=               # set for S3-compatible hosts (R2, MinIO)
# EXPORT_CACHE_CONTROL=public, max-age=300

# --- media encoding (rarely changed; see config/settings.py for the rungs) ---
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# VIDEO_H264_CRF=23
# VIDEO_AV1_CRF=34
# VIDEO_AV1_PRESET=6
