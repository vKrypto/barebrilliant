# docker compose environment — `docker compose` auto-loads ./.env
#   cp .env.example .env   &&   docker compose up --build

# ---- host-published ports ----
STOREFRONT_PORT=8080
STORAGE_PORT=8000

# ---- storefront build args (Vite inlines these; change -> rebuild) ----

# Base path the app is served from ("/" for a root deploy).
VITE_BASE=/

# Events endpoint (AWS Lambda function URL), no trailing slash. Leave blank and
# events just queue in IndexedDB until it is set.
VITE_LAMBDA_URL=

# tenant_name header sent with events.
VITE_TENANT_NAME=barebrilliant.local

# Where the BROWSER fetches catalog/product JSON and product media. This is the
# host-published storage port (not the compose service name). If you change
# STORAGE_PORT, update these to match. Cross-origin JSON works because the
# storage service sends Access-Control-Allow-Origin: *.
VITE_CATALOG_BASE=http://localhost:8000
VITE_MEDIA_BASE=http://localhost:8000

# Cache-bust id baked into the service worker; bump to force clients to update.
SW_VERSION=docker-local
